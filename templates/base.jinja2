<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}FitBuddy Admin & Athlete Portal{% endblock %} - FitBuddy</title>
  <!-- Tailwind CSS CDN for instant responsive rendering in Jinja2 template -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }
    code, .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-black">
  
  <!-- Navigation Bar -->
  <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Brand Logo -->
        <div class="flex items-center gap-3">
          <a href="/admin" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-slate-950 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-extrabold text-lg tracking-tight text-white">FitBuddy</span>
                <span class="text-[10px] font-mono uppercase tracking-widest bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5 rounded">Admin Portal</span>
              </div>
              <p class="text-[11px] text-slate-400 -mt-0.5">SQLite & SQLAlchemy Storage · Jinja2 Interface</p>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Items -->
        <nav class="hidden md:flex items-center gap-4 text-sm font-medium">
          <a href="/" class="text-slate-300 hover:text-emerald-400 px-3 py-1.5 rounded-lg hover:bg-slate-800/60 transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Back to Live App</span>
          </a>
          <a href="/admin" class="text-white bg-slate-800/90 border border-slate-700/80 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>Users & Plans</span>
          </a>
          <a href="/admin/database" class="text-slate-400 hover:text-white px-3 py-1.5 rounded-lg hover:bg-slate-800/60 transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
            </svg>
            <span>SQLite Schema</span>
          </a>
          <div class="h-4 w-px bg-slate-800"></div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            SQLite WAL Active
          </span>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <div class="md:hidden flex items-center gap-2">
          <a href="/" class="text-xs bg-slate-800 text-slate-200 border border-slate-700 px-2.5 py-1.5 rounded-lg">Live App</a>
          <button type="button" onclick="document.getElementById('mobileMenu').classList.toggle('hidden')" class="p-2 text-slate-400 hover:text-white rounded-lg bg-slate-800 border border-slate-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobileMenu" class="hidden md:hidden border-t border-slate-800 bg-slate-900 px-4 py-3 space-y-2">
      <a href="/" class="block px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-800">← Return to Live App</a>
      <a href="/admin" class="block px-3 py-2 rounded-lg text-sm font-semibold text-emerald-400 bg-slate-800/80">Admin Dashboard</a>
      <a href="/admin/database" class="block px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-800">SQLite & SQLAlchemy Schema</a>
    </div>
  </header>

  <!-- Main Body Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    {% block content %}{% endblock %}
  </main>

  <!-- Responsive Footer -->
  <footer class="border-t border-slate-800/80 bg-slate-950 py-6 text-xs text-slate-400 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-slate-400">
        <span class="font-bold text-white">FitBuddy Master Admin</span>
        <span>·</span>
        <span>SQLite + SQLAlchemy Database Models</span>
        <span>·</span>
        <span>Jinja2 Responsive Engine</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="/" class="hover:text-emerald-400 transition-colors">Client SPA</a>
        <span>·</span>
        <a href="/admin" class="hover:text-emerald-400 transition-colors">Admin Dashboard</a>
        <span>·</span>
        <span class="font-mono text-emerald-400">Low / Med / High Intensity Engine</span>
      </div>
    </div>
  </footer>

</body>
</html>
