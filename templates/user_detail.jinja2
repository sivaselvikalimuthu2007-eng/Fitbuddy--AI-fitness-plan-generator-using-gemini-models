{% extends "base.jinja2" %}

{% block title %}{{ user.name }} - Athlete Details{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Breadcrumb & Back Link -->
  <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
    <a href="/admin" class="hover:text-emerald-400 transition-colors">Admin Dashboard</a>
    <span>/</span>
    <span class="text-white">{{ user.name }}</span>
  </div>

  <!-- Athlete Profile Banner -->
  <div class="p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-5">
    <div class="flex items-start sm:items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center font-extrabold text-xl text-slate-950 shadow-lg shadow-emerald-500/20 flex-shrink-0">
        {{ user.name[0] }}
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-extrabold text-white">{{ user.name }}</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold
            {% if user.workout_intensity == 'low' %}bg-sky-500/10 text-sky-400 border border-sky-500/30
            {% elif user.workout_intensity == 'high' %}bg-amber-500/10 text-amber-400 border border-amber-500/30
            {% else %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/30{% endif %}">
            {{ (user.workout_intensity or 'medium') | upper }} INTENSITY
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700">
            {% if user.primary_goal == 'fat_loss' %}Weight Loss
            {% elif user.primary_goal == 'muscle_gain' %}Muscle Gain
            {% elif user.primary_goal == 'mobility_flexibility' %}Flexibility
            {% else %}General Health{% endif %}
          </span>
        </div>
        <div class="text-xs text-slate-400 font-mono mt-1">
          ID: <code class="text-emerald-400">{{ user.id }}</code> · {{ user.email }}
        </div>
        <div class="text-xs text-slate-300 mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
          <span><strong>Age:</strong> {{ user.age }} yrs</span>
          <span><strong>Weight:</strong> {{ user.weight_kg }} kg</span>
          <span><strong>Height:</strong> {{ user.height_cm }} cm</span>
          <span><strong>Schedule:</strong> {{ user.days_per_week }} days/wk ({{ user.minutes_per_session }} min)</span>
          <span><strong>Level:</strong> {{ user.experience_level | capitalize }}</span>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex flex-wrap gap-2">
      <a href="/" class="px-3 py-2 rounded-xl text-xs font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors">
        Open in Client App
      </a>
      <a href="/admin" class="px-3 py-2 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors">
        ← Back to Dashboard
      </a>
    </div>
  </div>

  <!-- Grid: Biomechanical Limitations & Available Equipment -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Equipment Card -->
    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <div class="text-xs font-mono uppercase text-emerald-400 font-bold mb-2">Available Equipment</div>
      <div class="flex flex-wrap gap-1.5">
        {% for eq in user.availableEquipment %}
          <span class="px-2.5 py-1 rounded-lg text-xs bg-slate-800 border border-slate-700 text-slate-200">
            {{ eq | replace('_', ' ') | capitalize }}
          </span>
        {% else %}
          <span class="text-xs text-slate-400 italic">Bodyweight only</span>
        {% endfor %}
      </div>
    </div>

    <!-- Limitations Card -->
    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <div class="text-xs font-mono uppercase text-amber-400 font-bold mb-2">Joint Health & Biomechanical Limitations</div>
      <div class="flex flex-wrap gap-1.5">
        {% for lim in user.limitations %}
          <span class="px-2.5 py-1 rounded-lg text-xs bg-amber-500/10 border border-amber-500/20 text-amber-300">
            ⚠️ {{ lim }}
          </span>
        {% else %}
          <span class="text-xs text-slate-400 italic">No movement limitations reported</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- AI-Generated Nutrition and Recovery Recommendations Section -->
  <div class="p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>AI-GENERATED NUTRITION & RECOVERY RECOMMENDATIONS</span>
        </div>
        <h2 class="text-lg font-bold text-white mt-0.5">Metabolic Fueling & Sleep/Restoration Protocol</h2>
      </div>
      <span class="text-[11px] font-mono text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700">
        Table: nutrition_recommendations
      </span>
    </div>

    {% if user.nutrition and user.nutrition | length > 0 %}
      {% set rec = user.nutrition[0] %}
      <!-- Macro Targets Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 text-center">
          <div class="text-[11px] font-mono text-slate-400">DAILY CALORIES</div>
          <div class="text-xl sm:text-2xl font-extrabold text-white mt-1">{{ rec.daily_calories }} <span class="text-xs font-normal text-slate-400">kcal</span></div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 text-center">
          <div class="text-[11px] font-mono text-emerald-400">PROTEIN TARGET</div>
          <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 mt-1">{{ rec.protein_grams }} <span class="text-xs font-normal text-slate-400">g</span></div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 text-center">
          <div class="text-[11px] font-mono text-sky-400">CARBOHYDRATES</div>
          <div class="text-xl sm:text-2xl font-extrabold text-sky-400 mt-1">{{ rec.carbs_grams }} <span class="text-xs font-normal text-slate-400">g</span></div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 text-center">
          <div class="text-[11px] font-mono text-amber-400">HEALTHY FATS</div>
          <div class="text-xl sm:text-2xl font-extrabold text-amber-400 mt-1">{{ rec.fats_grams }} <span class="text-xs font-normal text-slate-400">g</span></div>
        </div>
      </div>

      <!-- Nutrition & Timing Protocol -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl bg-slate-950/40 border border-slate-800 space-y-2">
          <div class="text-xs font-mono text-emerald-400 font-bold flex items-center gap-1.5">
            <span>🥗</span> Meal Timing & Macro Distribution
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{{ rec.meal_timing_protocol }}</p>
          <div class="pt-2 text-xs text-slate-400">
            <strong>Hydration Target:</strong> {{ rec.hydration_liters }} Liters structured water daily.
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/40 border border-slate-800 space-y-2">
          <div class="text-xs font-mono text-purple-400 font-bold flex items-center gap-1.5">
            <span>🌙</span> Sleep & Parasympathetic Restoration
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{{ rec.sleep_recovery_protocol }}</p>
          <div class="pt-2 text-xs text-slate-400">
            <strong>Active Recovery:</strong> {{ rec.active_recovery_protocol }}
          </div>
        </div>
      </div>
    {% else %}
      <p class="text-xs text-slate-400 italic">No nutrition recommendations generated yet. Generate a workout plan in the main app to calibrate nutrition.</p>
    {% endif %}
  </div>

  <!-- Active Workout Plans Section -->
  <div class="p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-sky-400 font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>WORKOUT PLAN REPOSITORY</span>
        </div>
        <h2 class="text-lg font-bold text-white mt-0.5">Assigned 7-Day Fitness Programs</h2>
      </div>
      <span class="text-[11px] font-mono text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700">
        Table: workout_plans
      </span>
    </div>

    {% for plan in user.plans %}
      <div class="p-4 sm:p-5 rounded-xl bg-slate-950/60 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-base font-bold text-white">{{ plan.title }}</span>
              <span class="text-xs font-mono px-2 py-0.5 rounded-full border
                {% if plan.intensity == 'low' %}bg-sky-500/10 text-sky-400 border-sky-500/30
                {% elif plan.intensity == 'high' %}bg-amber-500/10 text-amber-400 border-amber-500/30
                {% else %}bg-emerald-500/10 text-emerald-400 border-emerald-500/30{% endif %}">
                {{ (plan.intensity or 'medium') | upper }} INTENSITY
              </span>
            </div>
            <p class="text-xs text-slate-300">{{ plan.overview }}</p>
          </div>
          <div class="text-right text-[11px] font-mono text-slate-400">
            <div>{{ plan.split_type or plan.splitType }}</div>
            <div class="text-slate-500 mt-0.5">{{ plan.generated_at | truncate(16, true, "") }}</div>
          </div>
        </div>

        <!-- 7-Day Schedule Accordion/Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {% for day in plan.weeklySchedule %}
            <div class="p-3 rounded-lg bg-slate-900 border border-slate-800/80 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono mb-1">
                  <span class="font-bold text-slate-300">DAY {{ day.dayNumber }}</span>
                  {% if day.isRestDay %}
                    <span class="text-purple-400">REST</span>
                  {% else %}
                    <span class="text-amber-400">{{ day.estimatedDurationMin }}m</span>
                  {% endif %}
                </div>
                <div class="text-xs font-bold text-white leading-snug line-clamp-2 mb-1">{{ day.dayTitle }}</div>
                <div class="text-[11px] text-slate-400 line-clamp-1 mb-2">{{ day.focus }}</div>
              </div>
              <div class="text-[10px] text-slate-400 font-mono pt-2 border-t border-slate-800 flex justify-between">
                <span>{{ day.exercises | length }} exercises</span>
                <span class="text-emerald-400">~{{ day.estimatedCaloriesBurn }} kcal</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <p class="text-xs text-slate-400 italic">No plans generated yet for this athlete.</p>
    {% endfor %}
  </div>

  <!-- Feedback Modification History -->
  <div class="p-5 sm:p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm space-y-3">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
      <div>
        <div class="text-xs font-mono text-purple-400 font-bold">FEEDBACK-BASED MODIFICATIONS</div>
        <h3 class="text-base font-bold text-white mt-0.5">Adaptation Audit Trail</h3>
      </div>
      <span class="text-xs font-mono text-slate-400 bg-slate-800 px-2 py-1 rounded border border-slate-700">
        Table: feedback_logs
      </span>
    </div>

    {% for fb in user.feedbacks %}
      <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800 text-xs space-y-1">
        <div class="flex items-center justify-between text-slate-400 font-mono text-[11px]">
          <span class="text-purple-400 font-bold uppercase">Type: {{ fb.adaptation_type }}</span>
          <span>{{ fb.created_at }}</span>
        </div>
        <div class="text-slate-200"><strong>User Prompt:</strong> "{{ fb.feedback_text }}"</div>
        {% if fb.adaptation_summary %}
          <div class="text-emerald-400"><strong>Result:</strong> {{ fb.adaptation_summary }}</div>
        {% endif %}
      </div>
    {% else %}
      <p class="text-xs text-slate-400 italic">No feedback adaptations logged yet.</p>
    {% endfor %}
  </div>

</div>
{% endblock %}
